{
  "name": "codediff-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Bun diff engine for codediff.nvim built on @pierre/diffs",
  "type": "module",
  "scripts": {
    "start": "bun run src/main.ts",
    "bundle": "bun build src/main.ts --target=bun --outfile=dist/main.js",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt --write src",
    "format:check": "oxfmt --check src",
    "lint": "oxlint src --deny-warnings",
    "lint:fix": "oxlint src --fix"
  },
  "dependencies": {
    "@pierre/diffs": "1.2.2",
    "diff": "^8.0.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.56.0",
    "typescript": "^5.9.3"
  }
}
