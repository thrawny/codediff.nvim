{
  "name": "codediff-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Bun diff engine for codediff.nvim built on @pierre/diffs",
  "type": "module",
  "scripts": {
    "start": "bun run src/main.ts",
    "bundle": "bun build src/main.ts --target=bun --outfile=dist/main.js",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt --write src",
    "format:check": "oxfmt --check src",
    "lint": "oxlint src --deny-warnings",
    "lint:fix": "oxlint src --fix"
  },
  "dependencies": {
    "@pierre/diffs": "1.7.1",
    "@pierre/patches": "0.0.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.5",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "typescript": "^7.0.2"
  }
}
